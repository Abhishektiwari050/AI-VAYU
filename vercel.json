{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/aai-sync",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets/|sw.js|manifest.json|vayu-logo.svg|favicon.svg|favicon.ico|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
